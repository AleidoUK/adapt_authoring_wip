<div class="light-course-component-default-editor-inner">
  <div class="light-course-component-default-editor-toolbar">
    <a href="#" class="light-course-component-default-editor-back-to-list">&laquo; {{t 'app.lightcoursecomponentdefaultsbacktolist'}}</a>
    <h1>{{#if name}}{{name}}{{else}}{{t 'app.lightcoursecomponentdefaultnew'}}{{/if}}</h1>
    <div class="light-course-component-default-editor-toolbar-actions">
      <button class="btn primary light-course-component-default-editor-save">{{t 'app.lightcoursecomponentdefaultsave'}}</button>
    </div>
  </div>

  <section class="light-course-component-default-editor-section">
    <div class="field-row">
      <label>{{t 'app.lightcoursecomponentdefaultname'}}</label>
      <input type="text" class="light-course-component-default-editor-name" value="{{name}}">
    </div>
    <div class="field-row">
      <label>{{t 'app.lightcoursecomponentdefaultdescription'}}</label>
      <textarea class="light-course-component-default-editor-description">{{description}}</textarea>
    </div>
    <div class="field-row">
      <label>{{t 'app.lightcoursecomponenttype'}}</label>
      <select class="light-course-component-default-editor-type"></select>
    </div>
    <div class="field-row">
      <label>
        <input type="checkbox" class="light-course-component-default-editor-isdefault" {{#if isDefault}}checked="checked"{{/if}}>
        {{t 'app.lightcoursecomponentdefaultisdefault'}}
      </label>
    </div>
  </section>

  <div class="light-course-component-default-editor-form-container"></div>
</div>
