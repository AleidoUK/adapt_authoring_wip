<div class="light-course-config-inner">
  <div class="light-course-config-toolbar">
    {{!-- <h1>{{t 'app.lightcourseconfig'}}</h1> --}}
    <div class="light-course-config-toolbar-actions">
      <button class="btn primary light-course-config-save">{{t 'app.lightcourseconfigsave'}}</button>
      <button class="btn secondary-hollow light-course-item-history">{{t 'app.editorauditlog'}}</button>
    </div>
  </div>

  <section class="light-course-config-section">
    <h1>{{t 'app.lightcourseconfigplugindefaults'}}</h1>
    <p>{{t 'app.lightcourseconfigplugindefaultshelp'}}</p>
    <div class="field-row">
      <label>{{t 'app.lightcoursemenu'}}</label>
      <select class="light-course-config-menu-select"></select>
    </div>
    <div class="field-row">
      <label>{{t 'app.lightcoursetheme'}}</label>
      <select class="light-course-config-theme-select"></select>
    </div>
    <div class="field-row">
      <label>{{t 'app.lightcourseextensions'}}</label>
      <div class="light-course-config-extensions-list"></div>
    </div>
  </section>

  <section class="light-course-config-section">
    <h1>{{t 'app.lightcourseconfigicondefaults'}}</h1>
    <p>{{t 'app.lightcourseconfigicondefaultshelp'}}</p>
    <div class="field-row">
      <label>{{t 'app.lightcoursemenubutton'}}</label>
      <div class="light-course-config-icon-menuButton"></div>
    </div>
    <div class="field-row">
      <label>{{t 'app.lightcoursereflectionbutton'}}</label>
      <div class="light-course-config-icon-reflection"></div>
    </div>
    <div class="field-row">
      <label>{{t 'app.lightcoursehelpbutton'}}</label>
      <div class="light-course-config-icon-help"></div>
    </div>
  </section>
</div>
