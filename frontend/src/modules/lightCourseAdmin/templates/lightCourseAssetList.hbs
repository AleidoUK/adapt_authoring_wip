<div class="light-course-asset-list-inner">
  <div class="light-course-asset-list-header">
    <h1>{{t 'app.lightcourseassetupload'}}</h1>
    <div class="light-course-asset-list-upload-form">
      <div class="field-row">
        <label>{{t 'app.lightcourseassettitle'}}</label>
        <input type="text" class="light-course-asset-list-upload-title">
      </div>
      <div class="field-row">
        <label>{{t 'app.lightcourseassettype'}}</label>
        <select class="light-course-asset-list-upload-type">
          <option value="image">{{t 'app.lightcourseassettypeimage'}}</option>
          <option value="audio">{{t 'app.lightcourseassettypeaudio'}}</option>
        </select>
      </div>
      <div class="field-row">
        <label>{{t 'app.lightcourseassetfile'}}</label>
        <input type="file" class="light-course-asset-list-upload-file">
      </div>
      <button class="btn primary light-course-asset-list-upload-submit">{{t 'app.lightcourseassetuploadsubmit'}}</button>
    </div>
  </div>

  <div class="tb-heading col-row tb-row">
    <div class="col-10"></div>
    <div class="col-25"><div class="tb-col-inner"><h4>{{t 'app.lightcourseassettitlecol'}}</h4></div></div>
    <div class="col-15"><div class="tb-col-inner"><h4>{{t 'app.lightcourseassettype'}}</h4></div></div>
    <div class="col-15"><div class="tb-col-inner"><h4>{{t 'app.lightcourseassetsize'}}</h4></div></div>
    <div class="col-10"><div class="tb-col-inner"><h4>{{t 'app.lastupdated'}}</h4></div></div>
    <div class="col-25"></div>
  </div>

  <div class="light-course-asset-list-empty display-none">{{t 'app.lightcourseassetnonetodisplay'}}</div>
  <div class="light-course-asset-list-items"></div>
</div>
