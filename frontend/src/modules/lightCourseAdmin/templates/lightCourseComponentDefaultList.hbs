<div class="light-course-component-default-list-inner">
  <div class="light-course-component-default-list-header">
    <div class="light-course-component-default-list-header-actions">
      <button class="btn primary light-course-component-default-list-create">{{t 'app.lightcoursecomponentdefaultcreate'}}</button>
    </div>
  </div>

  <div class="light-course-admin-filters">
    <div class="light-course-admin-filter">
      <label for="light-course-default-search">{{t 'app.lightcoursefiltersearch'}}</label>
      <input id="light-course-default-search" class="light-course-admin-filter-search" type="search" placeholder="{{t 'app.lightcoursefilterdefaults'}}">
    </div>
    <div class="light-course-admin-filter">
      <label for="light-course-default-filter-type">{{t 'app.lightcoursecomponenttype'}}</label>
      <select id="light-course-default-filter-type" class="light-course-admin-filter-type">
        <option value="">{{t 'app.lightcoursefilteralltypes'}}</option>
      </select>
    </div>
    <div class="light-course-admin-filter">
      <label for="light-course-default-filter-status">{{t 'app.lightcoursecomponentdefaultisdefault'}}</label>
      <select id="light-course-default-filter-status" class="light-course-admin-filter-status">
        <option value="">{{t 'app.lightcoursefilterallstatuses'}}</option>
        <option value="default">{{t 'app.lightcoursefilterdefaultonly'}}</option>
        <option value="other">{{t 'app.lightcoursefilternondefault'}}</option>
      </select>
    </div>
    <button class="btn light-course-admin-filter-clear" disabled>{{t 'app.lightcourselistclearfilters'}}</button>
  </div>
  <p class="light-course-admin-filter-results" role="status" aria-live="polite" aria-atomic="true"></p>

  <div class="tb-heading col-row tb-row">
    <div class="col-25"><div class="tb-col-inner"><h4>{{t 'app.lightcoursecomponentdefaultname'}}</h4></div></div>
    <div class="col-20"><div class="tb-col-inner"><h4>{{t 'app.lightcoursecomponenttype'}}</h4></div></div>
    <div class="col-15"><div class="tb-col-inner"><h4>{{t 'app.lightcoursecomponentdefaultisdefault'}}</h4></div></div>
    <div class="col-10"><div class="tb-col-inner"><h4>{{t 'app.lastupdated'}}</h4></div></div>
    <div class="col-30"></div>
  </div>

  <div class="light-course-component-default-list-empty display-none">{{t 'app.lightcoursecomponentdefaultnonetodisplay'}}</div>
  <div class="light-course-component-default-list-items"></div>
</div>
