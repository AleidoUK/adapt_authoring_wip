<div class="col-row">
  <div class="col-10">
    <div class="tb-col-inner">
      <img class="light-course-asset-list-item-thumb" src="api/content/lightcourseasset/{{_id}}/thumb">
    </div>
  </div>
  <div class="col-20">
    <div class="tb-col-inner">
      <span class="light-course-asset-list-item-title no-wrap">{{{title}}}</span>
    </div>
  </div>
  <div class="col-10">
    <div class="tb-col-inner light-course-asset-list-item-type no-wrap"></div>
  </div>
  <div class="col-10">
    <div class="tb-col-inner light-course-asset-list-item-size no-wrap"></div>
  </div>
  <div class="col-15">
    <div class="tb-col-inner light-course-asset-list-item-uses"></div>
  </div>
  <div class="col-10">
    <div class="tb-col-inner">{{momentFormat updatedAt "Do MMMM YYYY HH:mm"}}</div>
  </div>
  <div class="col-25 light-course-asset-list-item-actions">
    <div class="tb-col-inner">
      <button class="btn primary light-course-asset-list-item-edit">{{t 'app.edit'}}</button>
      <button class="btn secondary-hollow light-course-item-history">{{t 'app.editorauditlog'}}</button>
      <button class="btn alert light-course-asset-list-item-delete">{{t 'app.delete'}}</button>
    </div>
  </div>
</div>
