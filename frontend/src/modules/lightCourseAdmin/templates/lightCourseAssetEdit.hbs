<div class="field-row">
  <label>{{t 'app.lightcourseassettitle'}}</label>
  <input type="text" class="light-course-asset-edit-title" value="{{title}}">
</div>
<div class="field-row">
  <label for="light-course-asset-edit-file">{{t 'app.lightcourseassetreplacefile'}}</label>
  <p>{{t 'app.lightcourseassetreplacehelp'}}</p>
  <input id="light-course-asset-edit-file" type="file" class="light-course-asset-edit-file">
</div>
<div class="field-row">
  <label>{{t 'app.lightcourseassetdescription'}}</label>
  <textarea class="light-course-asset-edit-description">{{description}}</textarea>
</div>
