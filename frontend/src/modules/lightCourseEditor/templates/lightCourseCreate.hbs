<div class="light-course-create-inner">
  <h1>{{t 'app.lightcoursecreatetitle'}}</h1>

  <div class="field-row">
    <label>{{t 'app.title'}}</label>
    <input type="text" class="light-course-create-title" value="{{title}}">
  </div>

  <div class="field-row">
    <label>{{t 'app.lightcoursetemplate'}}</label>
    <select class="light-course-create-template">
      <option value="">{{t 'app.lightcoursetemplateblank'}}</option>
    </select>
  </div>

  <div class="light-course-create-actions">
    <button class="btn primary light-course-create-save">{{t 'app.save'}}</button>
    <button class="btn secondary-hollow light-course-create-cancel">{{t 'app.cancel'}}</button>
  </div>
</div>
