<div class="light-course-editor-inner">
  <div class="light-course-editor-conflict-banner display-none">
    <p>{{t 'app.lightcourseconflictmessage'}}</p>
    <button class="btn alert light-course-editor-conflict-reload">{{t 'app.lightcoursereload'}}</button>
  </div>

  {{#if conversionStatus}}
  {{#ifValueEquals conversionStatus "converted"}}
  <div class="light-course-editor-locked-banner">
    {{t 'app.lightcourselockedmessage'}}
  </div>
  {{/ifValueEquals}}
  {{/if}}

  <div class="light-course-editor-toolbar">
    <a href="#" class="light-course-editor-back-to-list action-secondary">&laquo; {{t 'app.lightcoursebacktolist'}}</a>
    {{!-- <h1>{{title}}</h1> --}}
    <span class="light-course-editor-save-status" data-state="saved">{{t 'app.lightcoursesavestatussaved'}}</span>
    <div class="light-course-editor-toolbar-actions">
      <button class="btn primary light-course-editor-create-minor-version"></button>
      <button class="btn primary light-course-editor-create-major-version"></button>
      <button class="btn secondary light-course-editor-read">{{t 'app.lightcourseread'}}</button>
      <button class="btn secondary light-course-editor-edit-current-entry">{{t 'app.lightcourseeditcurrententry'}}</button>
      <button class="btn secondary-hollow light-course-editor-word">{{t 'app.lightcourseword'}}</button>
      <button class="btn secondary-hollow light-course-editor-versions">{{t 'app.lightcoursesavedversions'}}</button>
      <button class="btn secondary-hollow light-course-editor-auditlog">{{t 'app.editorauditlog'}}</button>
    </div>
  </div>

  <section class="light-course-editor-tags">
    <label for="light-course-tags-{{_id}}">{{t 'app.lightcoursetags'}}</label>
    <input type="text" id="light-course-tags-{{_id}}" class="light-course-editor-tags-input">
    <p>{{t 'app.lightcoursetagshelp'}}</p>
  </section>

  <div class="light-course-editor-tree-container"></div>

  <section class="light-course-editor-section light-course-editor-glossary">
    <h1>{{t 'app.lightcourseglossary'}}</h1>
    <div class="light-course-editor-glossary-container"></div>
  </section>

  <section class="light-course-editor-section light-course-editor-resources">
    <h1>{{t 'app.lightcourseresources'}}</h1>
    <div class="light-course-editor-resources-container"></div>
  </section>

  <section class="light-course-editor-section light-course-editor-help">
    <h1>{{t 'app.lightcoursehelp'}}</h1>
    <div class="light-course-editor-help-container"></div>
  </section>

  <details class="light-course-editor-settings">
    <summary>{{t 'app.lightcourseeditorsettings'}}</summary>
    <div class="light-course-editor-settings-content">
      <div class="light-course-editor-header-container"></div>

      <section class="light-course-editor-section light-course-editor-menu-section">
        <h1>{{t 'app.lightcoursemenusection'}}</h1>
        <p>{{t 'app.lightcoursemenusectionhelp'}}</p>
        <div class="field-row column">
          <label>{{t 'app.lightcoursemenutitle'}}</label>
          <input type="text" class="light-course-editor-menu-title" value="{{title}}">
        </div>
        <div class="field-row column">
          <label>{{t 'app.lightcoursemenubody'}}</label>
          <textarea class="light-course-editor-menu-body">{{body}}</textarea>
        </div>
      </section>

      <section class="light-course-editor-section light-course-editor-plugins">
        <h1>{{t 'app.lightcoursepluginselections'}}</h1>
        <div class="field-row column">
          <label>{{t 'app.lightcoursemenu'}}</label>
          <select class="light-course-editor-menu-select"></select>
        </div>
        <div class="field-row column">
          <label>{{t 'app.lightcoursetheme'}}</label>
          <select class="light-course-editor-theme-select"></select>
        </div>
        <div class="field-row column">
          <label>{{t 'app.lightcourseextensions'}}</label>
          <div class="light-course-editor-extensions-list"></div>
        </div>
      </section>
    </div>
  </details>
</div>
