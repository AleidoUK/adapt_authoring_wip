<div class="light-course-ref-picker-inner">
  <input type="text" class="light-course-ref-picker-search" placeholder="{{t 'app.lightcourserefpickersearch'}}">
  <div class="light-course-ref-picker-marker-toggle-row field-row">
    <label>
      <input type="checkbox" class="light-course-ref-picker-marker-toggle">
      {{t 'app.lightcourserefpickermarkeronly'}}
    </label>
    <p class="light-course-ref-picker-marker-toggle-help">{{t 'app.lightcourserefpickermarkeronlyhelp'}}</p>
  </div>
  <div class="light-course-ref-picker-items"></div>
</div>
