{{!-- Recursive node partial for the light course content tree (Phase 3).
      Context is a single node: { _id, type, children, _component, title }.
      type is one of submenu/page/article/block/component. --}}
<li class="light-course-tree-node light-course-tree-node-{{type}}{{#with (lookup @root.nodeMeta _id)}}{{#if layout}} light-course-tree-component-{{layout}}{{/if}}{{#if collapsed}} is-collapsed{{/if}}{{/with}}" data-node-id="{{_id}}" data-node-type="{{type}}">
  <div class="light-course-tree-node-row">
    {{#with (lookup @root.nodeMeta _id)}}
      {{#if collapsible}}
        <button type="button" class="btn-icon light-course-tree-toggle" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}" aria-label="{{toggleLabel}}" title="{{toggleLabel}}"><i class="fa {{#if collapsed}}fa-caret-right{{else}}fa-caret-down{{/if}}" aria-hidden="true"></i></button>
      {{/if}}
    {{/with}}
    {{#ifValueEquals type "submenu"}}
      <span class="light-course-tree-submenu-label"><i class="fa fa-folder" aria-hidden="true"></i> {{t 'app.lightcoursesubmenu'}}</span>
      <h1 class="light-course-tree-node-label light-course-tree-page-heading">
        <input type="text" class="light-course-tree-page-title-input" value="{{title}}" aria-label="{{t 'app.lightcoursesubmenutitle'}}" placeholder="{{t 'app.lightcoursesubmenu'}}">
      </h1>
    {{else}}{{#ifValueEquals type "page"}}
      <h1 class="light-course-tree-node-label light-course-tree-page-heading">
        <input type="text" class="light-course-tree-page-title-input" value="{{title}}" aria-label="{{t 'app.lightcoursepagetitle'}}" placeholder="{{t 'app.lightcoursepage'}}">
      </h1>
    {{else}}{{#ifValueEquals type "article"}}
      <span class="light-course-tree-node-label">{{t 'app.lightcoursearticle'}}</span>
    {{else}}{{#ifValueEquals type "block"}}
      <span class="light-course-tree-node-label">{{t 'app.lightcourseblock'}}{{#with (lookup @root.nodeMeta _id)}}{{#if componentTypeSummary}} ({{componentTypeSummary}}){{/if}}{{/with}}</span>
    {{else}}
      {{#with (lookup @root.nodeMeta _id)}}
        <span class="light-course-tree-node-label light-course-tree-component-label">
          <span class="light-course-tree-component-type">{{componentTypeDisplayName}}</span>
          <span class="light-course-tree-component-title">{{#if ../displayTitle}}{{../displayTitle}}{{else}}{{../title}}{{/if}}</span>
          {{#if ../uniqueId}}<span class="light-course-tree-component-uniqueid">({{t 'app.lightcourseuniqueid'}}: {{../uniqueId}})</span>{{/if}}
          <span class="light-course-tree-component-wordcount">{{wordCount}} {{t 'app.lightcoursewords'}}</span>
          <span class="light-course-tree-component-layout">{{layout}}</span>
          {{#if hasComments}}<span class="light-course-tree-component-comments{{#if allCommentsResolved}} is-resolved{{/if}}" role="img" aria-label="{{#if allCommentsResolved}}{{t 'app.lightcoursecommentsallresolved'}}{{else}}{{t 'app.lightcoursecommentsunresolved'}}{{/if}}" title="{{#if allCommentsResolved}}{{t 'app.lightcoursecommentsallresolved'}}{{else}}{{t 'app.lightcoursecommentsunresolved'}}{{/if}}"><i class="fa fa-comments" aria-hidden="true"></i></span>{{/if}}
        </span>
      {{/with}}
    {{/ifValueEquals}}{{/ifValueEquals}}{{/ifValueEquals}}{{/ifValueEquals}}

    <span class="light-course-tree-node-actions">
      {{#ifValueEquals type "page"}}
        {{#with (lookup @root.nodeMeta _id)}}
          {{#if submenus}}
          <label>{{t 'app.lightcoursepageparent'}}
            <select class="light-course-tree-page-parent">
              <option value="" {{#if atRoot}}selected{{/if}}>{{t 'app.lightcoursecourseroot'}}</option>
              {{#each submenus}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{title}}</option>{{/each}}
            </select>
          </label>
          {{/if}}
        {{/with}}
      {{/ifValueEquals}}
      {{#ifValueEquals type "page"}}
        <button type="button" class="btn-icon light-course-tree-move-up" title="{{t 'app.lightcoursemoveup'}}" aria-label="{{t 'app.lightcoursemoveup'}}" {{#if @first}}disabled{{/if}}><i class="fa fa-arrow-up" aria-hidden="true"></i></button>
        <button type="button" class="btn-icon light-course-tree-move-down" title="{{t 'app.lightcoursemovedown'}}" aria-label="{{t 'app.lightcoursemovedown'}}" {{#if @last}}disabled{{/if}}><i class="fa fa-arrow-down" aria-hidden="true"></i></button>
      {{else}}{{#ifValueEquals type "article"}}
        <button type="button" class="btn-icon light-course-tree-move-up" title="{{t 'app.lightcoursemoveup'}}" aria-label="{{t 'app.lightcoursemoveup'}}" {{#if @first}}disabled{{/if}}><i class="fa fa-arrow-up" aria-hidden="true"></i></button>
        <button type="button" class="btn-icon light-course-tree-move-down" title="{{t 'app.lightcoursemovedown'}}" aria-label="{{t 'app.lightcoursemovedown'}}" {{#if @last}}disabled{{/if}}><i class="fa fa-arrow-down" aria-hidden="true"></i></button>
      {{else}}{{#ifValueEquals type "block"}}
        <button type="button" class="btn-icon light-course-tree-move-up" title="{{t 'app.lightcoursemoveup'}}" aria-label="{{t 'app.lightcoursemoveup'}}" {{#if @first}}disabled{{/if}}><i class="fa fa-arrow-up" aria-hidden="true"></i></button>
        <button type="button" class="btn-icon light-course-tree-move-down" title="{{t 'app.lightcoursemovedown'}}" aria-label="{{t 'app.lightcoursemovedown'}}" {{#if @last}}disabled{{/if}}><i class="fa fa-arrow-down" aria-hidden="true"></i></button>
      {{/ifValueEquals}}{{/ifValueEquals}}{{/ifValueEquals}}
      {{#ifValueEquals type "article"}}
      {{else}}{{#ifValueEquals type "submenu"}}
      {{else}}
        <button type="button" class="btn-icon light-course-tree-copy" title="{{t 'app.lightcoursecopy'}}" aria-label="{{t 'app.lightcoursecopy'}}"><i class="fa fa-copy"></i></button>
      {{/ifValueEquals}}{{/ifValueEquals}}
      {{#ifValueEquals type "component"}}
        <button class="btn-icon light-course-tree-edit" title="{{t 'app.edit'}}"><i class="fa fa-pencil"></i></button>
      {{else}}{{#ifValueEquals type "submenu"}}
        <button type="button" class="btn tertiary light-course-tree-add-submenu-page"><i class="fa fa-plus"></i> {{t 'app.lightcourseaddpage'}}</button>
      {{else}}{{#ifValueEquals type "page"}}
        <button class="btn secondary-hollow light-course-tree-add" title="{{t 'app.lightcourseaddchild'}}"><i class="fa fa-plus"></i> {{t 'app.lightcourseaddarticle'}}</button>
      {{else}}{{#ifValueEquals type "article"}}
        <button class="btn secondary light-course-tree-add" title="{{t 'app.lightcourseaddchild'}}"><i class="fa fa-plus"></i> {{t 'app.lightcourseaddblock'}}</button>
      {{else}}
        <button class="btn secondary light-course-tree-add" title="{{t 'app.lightcourseaddchild'}}"><i class="fa fa-plus"></i> {{t 'app.lightcourseaddcomponent'}}</button>
      {{/ifValueEquals}}{{/ifValueEquals}}{{/ifValueEquals}}{{/ifValueEquals}}
      {{#ifValueEquals @root.clipboardType "block"}}
        {{#ifValueEquals type "article"}}
          <button type="button" class="btn secondary-hollow light-course-tree-paste"><i class="fa fa-paste"></i> {{t 'app.lightcoursepasteblock'}}</button>
        {{/ifValueEquals}}
      {{else}}{{#ifValueEquals @root.clipboardType "component"}}
        {{#ifValueEquals type "block"}}
          <button type="button" class="btn secondary-hollow light-course-tree-paste"><i class="fa fa-paste"></i> {{t 'app.lightcoursepastecomponent'}}</button>
        {{/ifValueEquals}}
      {{/ifValueEquals}}{{/ifValueEquals}}
      <button class="btn-icon light-course-tree-remove" title="{{t 'app.remove'}}"><i class="fa fa-trash-o"></i></button>
    </span>
  </div>

  {{#with (lookup @root.nodeMeta _id)}}
    {{#if fields}}
      <dl class="light-course-tree-fields">
        {{#each fields}}
          {{> part_lightCourseTreeField}}
        {{/each}}
      </dl>
    {{/if}}
  {{/with}}

  {{#ifValueEquals type "component"}}
  {{else}}
    <ul class="light-course-tree-node-children light-course-tree-node-children-{{type}}">
      {{#each children}}
        {{> part_lightCourseTreeNode}}
      {{/each}}
    </ul>
    {{#ifValueEquals type "article"}}
      {{#if children}}
        <div class="light-course-tree-add-block-bottom">
          <button type="button" class="btn secondary light-course-tree-add" title="{{t 'app.lightcourseaddchild'}}"><i class="fa fa-plus"></i> {{t 'app.lightcourseaddblock'}}</button>
        </div>
      {{/if}}
    {{/ifValueEquals}}
  {{/ifValueEquals}}
</li>
