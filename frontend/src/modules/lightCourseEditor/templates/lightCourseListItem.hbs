<div class="col-row">
  <div class="col-30">
    <div class="tb-col-inner">
      <span class="light-course-list-item-title no-wrap">{{{title}}}</span>
    </div>
  </div>
  <div class="col-20">
    <div class="tb-col-inner no-wrap">{{momentFormat updatedAt "Do MMMM YYYY"}}</div>
  </div>
  <div class="col-20">
    <div class="tb-col-inner no-wrap">
      {{#if currentVersionNumber}}{{currentVersionNumber}}{{else}}{{t 'app.lightcoursedraftonly'}}{{/if}}
    </div>
  </div>
  <div class="col-10">
    <div class="tb-col-inner no-wrap">
      {{#ifValueEquals conversionStatus "converted"}}
        {{t 'app.lightcoursestateconverted'}}
      {{else}}
        {{t 'app.lightcoursestatedraft'}}
      {{/ifValueEquals}}
    </div>
  </div>
  <div class="col-20 light-course-list-item-actions">
    <div class="tb-col-inner">
      <button class="btn secondary-hollow light-course-list-item-edit">{{t 'app.edit'}}</button>
      <button class="btn alert light-course-list-item-delete">{{t 'app.delete'}}</button>
    </div>
  </div>
</div>
