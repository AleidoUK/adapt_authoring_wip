<div class="light-course-bank-asset-preview">
  {{#if hasValue}}
    {{#ifValueEquals assetType "audio"}}
      <audio controls src="api/asset/serve/{{assetId}}"></audio>
    {{else}}
      <img class="light-course-bank-asset-thumb" src="api/asset/thumb/{{assetId}}">
    {{/ifValueEquals}}
    <span class="light-course-bank-asset-preview-filename"></span>
  {{else}}
    <span class="light-course-bank-asset-none">{{t 'app.lightcoursenoassetchosen'}}</span>
  {{/if}}
</div>
<div class="light-course-bank-asset-actions">
  <button class="btn secondary-hollow light-course-bank-asset-browse">{{t 'app.lightcoursechoosefrombank'}}</button>
  <button class="btn secondary-hollow light-course-bank-asset-upload-trigger">{{t 'app.lightcourseuploadnew'}}</button>
  {{#if hasValue}}
  <button class="btn tertiary light-course-bank-asset-clear">{{t 'app.lightcourseclear'}}</button>
  {{/if}}
  <input type="file" class="light-course-bank-asset-file-input display-none">
</div>
<div class="light-course-bank-asset-bank-list"></div>
