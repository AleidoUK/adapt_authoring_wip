<div class="light-course-version-notes-inner">
  <div class="field-row">
    <label>{{t 'app.lightcourseversion'}}</label>
    <span class="light-course-version-notes-version"></span>
  </div>
  <div class="field-row">
    <label>{{t 'app.lightcoursewords'}}</label>
    <span class="light-course-version-notes-words"></span>
  </div>
  <div class="field-row">
    <label>{{t 'app.lightcoursenotes'}}</label>
    <textarea class="light-course-version-notes-notes"></textarea>
  </div>
  <div class="field-row">
    <label>{{t 'app.lightcourseestduration'}}</label>
    <input type="text" class="light-course-version-notes-duration">
    <p class="light-course-version-notes-duration-help">{{t 'app.lightcourseestdurationhelp'}}</p>
  </div>
</div>
