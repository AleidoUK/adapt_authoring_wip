{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema",
  "id": "http://jsonschema.net",
  "$ref": "http://localhost/system/tenantObject.schema",
  "properties": {
    "_lightCourseId": {
      "type": "objectid",
      "required": true
    },
    "_versionId": {
      "type": "objectid",
      "required": false
    },
    "isDraft": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "format": {
      "type": "string",
      "required": true,
      "enum": ["markdown", "docx"]
    },
    "renderedText": {
      "type": "string",
      "default": ""
    },
    "assetSnapshotRefs": {
      "type": "array",
      "default": [],
      "items": {
        "type": "objectid"
      }
    },
    "exportedAt": {
      "type": "date",
      "required": true
    }
  }
}
